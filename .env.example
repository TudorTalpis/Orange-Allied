# ==========================================
# Application
# ==========================================

APP_ENV=development


# ==========================================
# Frontend
# ==========================================

VITE_API_URL=http://localhost:8000


# ==========================================
# Backend
# ==========================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000


# ==========================================
# Authentication
# ==========================================

# Authentication strategy must be finalized
# between frontend and backend.
#
# Possible values:
# supabase
# fastapi_jwt

AUTH_PROVIDER=

# Used only if FastAPI-managed JWT is selected.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================================
# Supabase
# ==========================================

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend only.
# Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=


# ==========================================
# PostgreSQL - Local Development
# ==========================================

# Keep these variables while the team decides
# whether a local PostgreSQL container will be
# used for development.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orange_allied
POSTGRES_USER=orange_allied
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://orange_allied:change_me@localhost:5432/orange_allied


# ==========================================
# Google Cloud Vision / Document AI
# ==========================================

OCR_PROVIDER=google

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=


# ==========================================
# AI / LLM
# ==========================================

LLM_PROVIDER=ollama


# ==========================================
# Ollama
# ==========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=


# ==========================================
# Embeddings
# ==========================================

EMBEDDING_PROVIDER=


# ==========================================
# Cloud AI - Optional
# ==========================================

CLOUD_LLM_API_KEY=
