# Application
APP_ENV=development

# Frontend
VITE_API_URL=http://localhost:8000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Authentication / JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orange_allied
POSTGRES_USER=orange_allied
POSTGRES_PASSWORD=change_me

# Note: uses the +psycopg dialect suffix because the backend
# installs psycopg3 (psycopg[binary]), not psycopg2.
DATABASE_URL=postgresql+psycopg://orange_allied:change_me@localhost:5432/orange_allied

# Google Cloud Vision / Document AI
OCR_PROVIDER=google
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# AI / LLM
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Embeddings
EMBEDDING_PROVIDER=

# Optional Cloud AI
CLOUD_LLM_API_KEY=
